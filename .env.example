# ==========================================
# Content Agent - 环境变量配置示例
# ==========================================
# 复制此文件为 .env 后，填入你的 API Key
# 支持多种模型 Provider，通过 MODEL_PROVIDER 切换


# ------------------------------------------
# 【必填】选择 Provider（默认 deepseek）
# 有效值: deepseek | kimi | minimax | openai | custom
# ------------------------------------------
MODEL_PROVIDER=deepseek


# ==========================================
# 方案 1: DeepSeek（默认，推荐，性价比最高）
# ==========================================
# 官网: https://platform.deepseek.com
# 价格: 输入 1元/M tokens，输出 2元/M tokens
# 使用此方案时只需要下面这一行：
DEEPSEEK_API_KEY=sk-your-deepseek-api-key


# ==========================================
# 方案 2: Kimi (月之暗面 / Moonshot)
# ==========================================
# 官网: https://platform.moonshot.cn
# 支持模型: kimi-k2-6, kimi-k2-5 等
# 注意: 此处是 Kimi 开放平台 API，不是 Kimi Code 订阅！
# Kimi Code (coding plan) 有白名单限制，第三方工具无法接入。
# 如果你订阅了 Kimi Code，请额外注册 Kimi API 并充值使用。
# KIMI_API_KEY=sk-your-kimi-api-key


# ==========================================
# 方案 3: Minimax
# ==========================================
# 官网: https://platform.minimaxi.com
# 支持模型: abab6.5-chat, abab6 等
# MINIMAX_API_KEY=your-minimax-api-key


# ==========================================
# 方案 4: OpenAI / Azure
# ==========================================
# 支持模型: gpt-4o-mini, gpt-4o, gpt-3.5-turbo 等
# OPENAI_API_KEY=sk-your-openai-api-key


# ==========================================
# 方案 5: 自定义 OpenAI-compatible 平台
# ==========================================
# 适用于: 硅基流动、OneAPI、阿里通义千问、智谱大模型、本地部署等
# 需同时设置 MODEL_PROVIDER=custom 和以下三项：
# MODEL_PROVIDER=custom
# MODEL_BASE_URL=https://api.siliconflow.cn/v1
# MODEL_NAME=deepseek-ai/DeepSeek-V3
# MODEL_API_KEY=sk-your-api-key


# ==========================================
# 常见自定义平台示例（取消注释后使用）
# ==========================================

# --- 硅基流动 (SiliconFlow) ---
# MODEL_PROVIDER=custom
# MODEL_BASE_URL=https://api.siliconflow.cn/v1
# MODEL_NAME=deepseek-ai/DeepSeek-V3
# MODEL_API_KEY=sk-your-siliconflow-key

# --- 通义千问 (DashScope) ---
# MODEL_PROVIDER=custom
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus
# MODEL_API_KEY=sk-your-dashscope-key

# --- 智谱 AI (Zhipu) ---
# MODEL_PROVIDER=custom
# MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL_NAME=glm-4-flash
# MODEL_API_KEY=your-zhipu-api-key

# --- 本地 Ollama ---
# MODEL_PROVIDER=custom
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen2.5:7b
# MODEL_API_KEY=ollama  # Ollama 可以随便填
